{
  "Nlog": {
    "AutoReload": true,
    "ThrowExceptions": false,
    "InternalLogLevel": "Off",
    "internalLogFile": "/temp/nlog-internal.log",

    "Targets": {
      "@async": true,



      

/*      "LogStash": {
        "Type": "BufferingWrapper",
        "FlushTimeout": 5000,
        "Target": {
          "Type": "Network",
          "Name": "LS",
          "Address": "tcp://217.20.113.86:5050",
          "SslProtocols": "None",
          "NewLine": true,
          "Layout": {
            "Type": "SalJsonLayout"
          }
        }
      },*/

      "File": {
        "Type": "File",
        "Layout": "${longdate} ${sid:padding} ${level}: ${Logger} -> ${message} ${exception:format=Message,StackTrace}",
        "FileName": "${var:logDir}/${date:format=yyyy-MM-dd}.${var:adapterName}.Log",
        "CreateDirs": true
      },
      "LoggerFile": {
        "Type": "File",
        "Layout": "${longdate} ${sid:padding} ${level}: -> ${message} ${exception:format=Type, Message}",
        "FileName": "${var:logDir}/${date:format=yyyy-MM-dd}.${Logger}.${var:adapterName}.Log",
        "CreateDirs": true
      },
      "RMQFile": {
        "Type": "File",
        "Layout": "${longdate} ${sid:padding} ${Logger} ${level} -> ${message} ${exception:format=Type, Message}",
        "FileName": "${var:logDir}/${date:format=yyyy-MM-dd}.Rabbit.${var:adapterName}.Log",
        "CreateDirs": "true"
      },
      "WDFile": {
        "Type": "File",
        "Layout": "${longdate} ${sid:padding} ${level:padding=-6}:${Logger:padding=-17} -> ${message} ${exception:format=Type, Message}",
        "FileName": "${var:logDir}/${date:format=yyyy-MM-dd}.WatchDog.${var:adapterName}.Log",
        "CreateDirs": true
      },
      
      "CommandFile": {
        "Type": "File",
        "Layout": "${longdate} ${sid:padding} ${message} ${exception:format=Type, Message}",
        "FileName": "${var:logDir}/Commands/${date:format=yyyy-MM-dd}.${Logger}.Log",
        "CreateDirs": true
      },
      "EventFile": {
        "Type": "File",
        "Layout": "${longdate} ${sid:padding} ${message} ${exception:format=Type, Message}",
        "FileName": "${var:logDir}/Events/${date:format=yyyy-MM-dd}.${Logger}.Log",
        "CreateDirs": true
      },


      "ColoredConsole": {
        "Type": "ColoredConsole",
        "Layout": "${longdate} ${sid:padding} ${level}: ${Logger} -> ${message} ${exception:format=Message,StackTrace}",

        "UseDefaultRowHighlightingRules": false,
        "RowHighlightingRules": [
          {
            "Condition": "level == LogLevel.Debug",
            "ForegroundColor": "DarkGray"
          },
          {
            "Condition": "level == LogLevel.Info",
            "ForegroundColor": "Gray"
          },
          {
            "Condition": "level == LogLevel.Warn",
            "ForegroundColor": "Yellow"
          },
          {
            "Condition": "level == LogLevel.Error",
            "ForegroundColor": "Red"
          },
          {
            "Condition": "level == LogLevel.Fatal",
            "ForegroundColor": "Red",
            "BackgroundColor": "White"
          }
        ]

      },
      "BlackHole": {
        "Type": "Null",
        "FormatMessage": false
      }
    },
    "Rules": [
/*    {
        "Pattern": "*",
        "Minlevel": "Trace",
        "WriteTo": "LogStash",
        "Final": false
      },*/
      {
        "Pattern": "*",
        "Minlevel": "Trace",
        "WriteTo": "ColoredConsole",
        "Final": false
      },

      {
        "Pattern": "WatchDog*",
        "Minlevel": "Trace",
        "WriteTo": "WDFile",
        "Final": true
      },
      {
        "Pattern": "RMQ*",
        "Minlevel": "Trace",
        "WriteTo": "RMQFile",
        "Final": true
      },
      {
        "Pattern": "*Command",
        "Minlevel": "Trace",
        "WriteTo": "CommandFile",
        "Final": true
      },
      {
        "Pattern": "*Event",
        "Minlevel": "Trace",
        "WriteTo": "EventFile",
        "Final": true
      },
      {
        "Pattern": "*",
        "Minlevel": "Trace",
        "WriteTo": "File"
      }
    ]
  }
}